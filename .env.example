# Normally nothing is needed; the setup wizard stores the database connection.
# Optional first-run bootstrap: set DATABASE_URL and LINE_AGENT_ATTACHMENT_ROOT together.
# They are persisted into %LOCALAPPDATA%\LineAgentAssistant\bootstrap.json on first start.
# Delete that file to run the setup wizard again.
DATABASE_URL=postgresql://line_agent:CHANGE_ME@localhost:5432/line_agent
LINE_AGENT_ATTACHMENT_ROOT=C:\ProgramData\LINEAgentAssistant\attachments

# Optional fallback when the setup wizard has no workspace configured.
LINE_AGENT_WORKSPACE=C:\LineAgentWorkspace

# Disposable test/demo profile (`docker compose -f docker-compose.demo.yml up -d`).
TEST_DATABASE_URL=postgresql://line_agent_demo:line_agent_demo_only@127.0.0.1:55433/line_agent_demo
