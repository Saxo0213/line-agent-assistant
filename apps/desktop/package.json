{
  "name": "@line-agent/desktop",
  "private": true,
  "type": "module",
  "version": "1.0.314",
  "description": "Windows desktop console for LINE account automation with subscription agent CLIs",
  "author": "LINE Agent Assistant contributors",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
